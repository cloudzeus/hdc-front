{{#if issue.title}}
<!-- ISSUE -->
<tr><td class="px dm-body" style="padding:32px 24px 0; background-color:#ffffff;">
  {{#if issue.label}}<p style="margin:0 0 10px; font-family:$FONT; font-size:13px; line-height:16px; font-weight:800; letter-spacing:0.08em; color:$RED;">{{issue.label}}</p>{{/if}}
  <h1 class="h1 dm-text" style="margin:0 0 14px; font-family:$FONT; font-size:34px; line-height:36px; font-weight:900; letter-spacing:-0.02em; text-transform:uppercase; color:$INK;">{{issue.title}}</h1>
  {{#if issue.intro}}<p class="dm-muted" style="margin:0; font-family:$FONT; font-size:16px; line-height:25px; color:$G7;">{{issue.intro}}</p>{{/if}}
</td></tr>
<tr><td class="dm-body" style="height:28px; line-height:28px; font-size:0; background-color:#ffffff;">&nbsp;</td></tr>
{{/if}}
{{#if hero.title}}{{> hero}}{{/if}}
{{#each articles}}
<!-- ARTICLE -->
<tr><td class="px dm-body" style="padding:{{#if @first}}36{{else}}28{{/if}}px 24px 0; background-color:#ffffff;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
    {{#if image}}<td class="stack" width="200" valign="top" style="width:200px; padding-right:20px;">
      <a href="{{url}}" style="text-decoration:none;"><img src="{{img image 600}}" width="200" alt="{{title}}" style="display:block; width:100%; max-width:200px; height:auto; border:0; outline:none; font-family:$FONT; font-size:12px; color:$G5;"></a>
    </td>{{/if}}
    <td class="stack{{#if image}} stack-gap{{/if}}" valign="top">
      {{#if tag}}<table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td style="background-color:$INK; padding:4px 8px; font-family:$FONT; font-size:11px; line-height:14px; font-weight:800; letter-spacing:0.04em; color:#ffffff;">{{tag}}</td></tr></table>{{/if}}
      <h2 class="dm-text" style="margin:{{#if tag}}10{{else}}0{{/if}}px 0 8px; font-family:$FONT; font-size:20px; line-height:24px; font-weight:900; text-transform:uppercase; color:$INK;"><a href="{{url}}" class="dm-text" style="color:$INK; text-decoration:none;">{{title}}</a></h2>
      {{#if excerpt}}<p class="dm-muted" style="margin:0 0 10px; font-family:$FONT; font-size:15px; line-height:23px; color:$G7;">{{excerpt}}</p>{{/if}}
      <p style="margin:0; font-family:$FONT; font-size:13px; line-height:16px; font-weight:800; letter-spacing:0.06em;"><a href="{{url}}" style="color:$RED; text-decoration:none;">{{cta}}&nbsp;&rarr;</a></p>
    </td>
  </tr></table>
</td></tr>
{{#unless @last}}<tr><td class="px dm-body" style="padding:28px 24px 0; background-color:#ffffff;"><div class="dm-rule" style="border-top:1px solid $G3; font-size:0; line-height:0;">&nbsp;</div></td></tr>{{/unless}}
{{/each}}
{{#if cta.url}}{{> cta label=cta.label href=cta.url top=40 bottom=44}}{{else}}<tr><td class="dm-body" style="height:44px; line-height:44px; font-size:0; background-color:#ffffff;">&nbsp;</td></tr>{{/if}}
