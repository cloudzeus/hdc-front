{{> heading eyebrow=(T "internal.new_eyebrow") title=order.number lead=internal.state_line}}
{{> facts rows=internal.rows}}
{{#if order.supplier}}{{> note tone="wait" title=(T "internal.supplier") text=(t "internal.supplier_text")}}{{/if}}
{{#if internal.notes}}{{> note tone="red" title=(T "internal.notes") text=internal.notes}}{{/if}}
<!-- ITEMS -->
<tr><td class="px dm-body" style="padding:32px 24px 0; background-color:#ffffff;">
  {{> section-title title=(T "internal.items" count=order.items.length) aside=(t "order.prices_gross")}}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
{{#each order.items}}{{> order-line}}{{/each}}
  </table>
</td></tr>
{{> order-totals}}
{{> cta label=(T "internal.admin") href=internal.admin_url bottom=40}}
