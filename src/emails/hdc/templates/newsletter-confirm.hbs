{{> heading eyebrow=(T "subscribe.eyebrow") title=(T "subscribe.title") lead=(t "subscribe.lead")}}
{{> cta label=(T "subscribe.cta") href=subscribe.url note=(t "subscribe.valid" hours=subscribe.hours) top=32 bottom=8}}
<!-- WHAT -->
<tr><td class="px dm-body" style="padding:32px 24px 0; background-color:#ffffff;">
  {{> section-title title=(T "subscribe.what_title")}}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
    {{#each subscribe.what}}
    <tr>
      <td width="40" valign="top" style="width:40px; padding:14px 0; font-family:$FONT; font-size:15px; line-height:22px; font-weight:900; color:$RED;{{#unless @last}} border-bottom:1px solid $G3;{{/unless}}" class="dm-rule">0{{inc @index}}</td>
      <td valign="top" class="dm-text dm-rule" style="padding:14px 0; font-family:$FONT; font-size:15px; line-height:22px; color:$INK;{{#unless @last}} border-bottom:1px solid $G3;{{/unless}}">{{this}}</td>
    </tr>
    {{/each}}
  </table>
</td></tr>
{{> note tone="wait" title=(T "verify.ignore_title") text=(t "subscribe.ignore")}}
<tr><td class="dm-body" style="height:32px; line-height:32px; font-size:0; background-color:#ffffff;">&nbsp;</td></tr>
