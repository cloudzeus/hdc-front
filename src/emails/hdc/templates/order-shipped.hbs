{{> heading eyebrow=(T "shipped.eyebrow") title=(T "shipped.title") lead=(t "shipped.lead" number=order.number)}}
<!-- TRACKING -->
<tr><td class="px dm-body" style="padding:24px 24px 0; background-color:#ffffff;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="dm-panel" bgcolor="$G1" style="background-color:$G1;">
    <tr><td style="padding:20px 20px 22px;">
      <p class="dm-muted" style="margin:0 0 4px; font-family:$FONT; font-size:12px; line-height:16px; font-weight:800; letter-spacing:0.06em; color:$G5;">{{T "shipped.tracking"}}</p>
      <p class="dm-text" style="margin:0 0 16px; font-family:'Courier New', Courier, monospace; font-size:26px; line-height:30px; font-weight:700; letter-spacing:0.04em; color:$INK;">{{shipment.tracking}}</p>
      {{> button label=(T "shipped.track") href=shipment.tracking_url width=260}}
    </td></tr>
  </table>
</td></tr>
{{> facts rows=shipment.rows}}
{{> order-items}}
{{> two-cols cols=order.cols}}
{{> cta label=(T "order.view") href=order.url}}
{{> help lead=(t "help.order") reply=true}}
