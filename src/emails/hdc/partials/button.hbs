<table role="presentation" cellpadding="0" cellspacing="0" border="0"{{#if center}} align="center"{{/if}}><tr><td class="btn-cell" align="center" bgcolor="{{#if dark}}$INK{{else}}$RED{{/if}}" style="background-color:{{#if dark}}$INK{{else}}$RED{{/if}};">
  <!--[if mso]>
  <v:rect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{href}}" style="height:50px; v-text-anchor:middle; width:{{#if width}}{{width}}{{else}}300{{/if}}px;" stroked="f" fillcolor="{{#if dark}}$INK{{else}}$RED{{/if}}">
    <w:anchorlock/>
    <center style="color:#ffffff; font-family:Arial,sans-serif; font-size:15px; font-weight:bold; letter-spacing:1px;">{{label}}</center>
  </v:rect>
  <![endif]-->
  <!--[if !mso]><!-->
  <a href="{{href}}" style="display:inline-block; min-width:{{#if width}}{{minus width 56}}{{else}}244{{/if}}px; padding:16px 28px; background-color:{{#if dark}}$INK{{else}}$RED{{/if}}; color:#ffffff; font-family:$FONT; font-size:15px; line-height:18px; font-weight:800; letter-spacing:0.06em; text-align:center; text-decoration:none; border-radius:0;">{{label}}</a>
  <!--<![endif]-->
