<!-- CTA -->
<tr><td class="px dm-body" align="center" style="padding:{{#if top}}{{top}}{{else}}40{{/if}}px 24px {{#if bottom}}{{bottom}}{{else}}16{{/if}}px; background-color:#ffffff;">
  {{> button label=label href=href width=width center=true}}
