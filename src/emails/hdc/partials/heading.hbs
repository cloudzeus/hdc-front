<!-- TITLE -->
<tr><td class="px dm-body" style="padding:36px 24px 8px; background-color:#ffffff;">
  {{#if eyebrow}}<p style="margin:0 0 10px; font-family:$FONT; font-size:13px; line-height:16px; font-weight:800; letter-spacing:0.08em; color:$RED;">{{eyebrow}}</p>{{/if}}
  <h1 class="h1 dm-text" style="margin:0 0 14px; font-family:$FONT; font-size:34px; line-height:36px; font-weight:900; letter-spacing:-0.02em; text-transform:uppercase; color:$INK;">{{title}}</h1>
  {{#if lead}}<p class="dm-muted" style="margin:0; font-family:$FONT; font-size:16px; line-height:25px; color:$G7;">{{lead}}</p>{{/if}}
</td></tr>
