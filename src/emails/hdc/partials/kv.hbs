<tr>
  <td class="dm-muted" style="padding:5px 0; font-family:$FONT; font-size:15px; line-height:20px; color:$G7;">{{label}}</td>
  <td class="dm-text" align="right" style="padding:5px 0; font-family:$FONT; font-size:15px; line-height:20px; color:$INK;{{#if strong}} font-weight:700;{{/if}}{{#if strike}} text-decoration:line-through;{{/if}}">{{value}}</td>
</tr>
