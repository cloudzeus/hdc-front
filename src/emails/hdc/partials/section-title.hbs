<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
  <td style="border-bottom:3px solid $INK; padding-bottom:8px;" class="dm-rule">
    <span class="dm-text" style="font-family:$FONT; font-size:20px; line-height:24px; font-weight:900; text-transform:uppercase; color:$INK;">{{title}}</span>
  </td>
  {{#if aside}}<td align="right" valign="bottom" style="border-bottom:3px solid $INK; padding-bottom:10px;" class="dm-rule">
    <span class="dm-muted" style="font-family:$FONT; font-size:12px; line-height:16px; color:$G5;">{{aside}}</span>
  </td>{{/if}}
</tr></table>
