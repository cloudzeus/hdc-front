<!-- REQUEST ITEMS -->
<tr><td class="px dm-body" style="padding:32px 24px 0; background-color:#ffffff;">
  {{> section-title title=title aside=aside}}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
{{#each items}}
    <tr>
      <td class="dm-rule" valign="top" style="padding:16px 12px 16px 0;{{#unless @last}} border-bottom:1px solid $G3;{{/unless}}">
        {{#if tag}}<p class="{{#if struck}}dm-muted{{else}}dm-wait{{/if}}" style="margin:0 0 4px; font-family:$FONT; font-size:12px; line-height:16px; font-weight:800; letter-spacing:0.06em; color:{{#if struck}}$G5{{else}}$WAIT{{/if}};">{{upper tag}}</p>{{/if}}
        <p class="{{#if struck}}dm-muted{{else}}dm-text{{/if}}" style="margin:0 0 4px; font-family:$FONT; font-size:15px; line-height:20px; font-weight:700; color:{{#if struck}}$G5; text-decoration:line-through{{else}}$INK{{/if}};">{{name}}</p>
        <p class="dm-muted" style="margin:0; font-family:$FONT; font-size:13px; line-height:18px; color:$G5;">{{t "line.code"}} {{code}} · {{detail}}</p>
        {{#if was}}<p class="dm-muted" style="margin:4px 0 0; font-family:$FONT; font-size:13px; line-height:18px; color:$G7;">{{was}}</p>{{/if}}
      </td>
      <td class="dm-rule {{#if struck}}dm-muted{{else}}dm-text{{/if}}" valign="top" align="right" style="padding:16px 0; white-space:nowrap; font-family:$FONT; font-size:16px; line-height:20px; font-weight:800; color:{{#if struck}}$G5; text-decoration:line-through{{else}}$INK{{/if}};{{#unless @last}} border-bottom:1px solid $G3;{{/unless}}">{{total}}</td>
    </tr>
{{/each}}
  </table>
</td></tr>
