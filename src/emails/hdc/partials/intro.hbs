<!-- INTRO -->
<tr><td class="px dm-body" style="padding:36px 24px 8px; background-color:#ffffff;">
  {{#if title}}<h2 class="dm-text" style="margin:0 0 12px; font-family:$FONT; font-size:24px; line-height:28px; font-weight:900; letter-spacing:-0.01em; text-transform:uppercase; color:$INK;">{{title}}</h2>{{/if}}
  {{#each paragraphs}}<p class="dm-muted" style="margin:0{{#unless @last}} 0 12px{{/unless}}; font-family:$FONT; font-size:16px; line-height:25px; color:$G7;">{{this}}</p>{{/each}}
</td></tr>
